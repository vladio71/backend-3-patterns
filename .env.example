# Скопіюйте в .env. Значення нижче підходять для docker compose up.

# HTTP-порт API поза Docker. У docker compose порт в контейнері завжди 3002 (мапінг на хост задає API_PORT).
PORT=3002
# development (типово) або production. У production сервіс не стартує з JWT_SECRET і PAYMENT_WEBHOOK_SECRET
# за замовчуванням, а seed не чіпає базу, у якій уже є дані. docker compose без цього рядка бере development.
# NODE_ENV=production
# Секрет для підпису JWT (у production: довгий випадковий рядок)
JWT_SECRET=dev-secret-change-me
# Секрет HMAC для вебхука платіжного провайдера (модуль idempotency)
PAYMENT_WEBHOOK_SECRET=whsec-dev

# PostgreSQL. У docker compose DB_HOST перевизначається на postgres, а DB_USER, DB_PASSWORD, DB_NAME
# беруться звідси і для контейнера postgres, і для api та worker (змінюйте до першого запуску).
DB_HOST=localhost
DB_PORT=5432
DB_USER=patterns
DB_PASSWORD=patterns
DB_NAME=patterns
# true: друкувати кожен SQL-запит у консоль (модуль profiling)
DB_LOGGING=false

# Redis: кеш прапорців, черги BullMQ, демо-перемикачі
REDIS_HOST=localhost
REDIS_PORT=6379
# Номер БД Redis (0..15). Тести використовують 1, щоб не ділити черги з запущеним worker-ом.
REDIS_DB=0

# Сховище файлів (модуль files). s3: MinIO або AWS S3. fake: пам'ять процесу (тести).
STORAGE_DRIVER=s3
# Щоб перейти з MinIO на AWS S3, змініть саме ці 4 змінні:
#   S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com   (або порожньо: SDK сам підставить регіональний endpoint)
#   S3_REGION=eu-central-1
#   S3_ACCESS_KEY_ID=<ключ IAM-користувача з правами на бакет>
#   S3_SECRET_ACCESS_KEY=<секрет IAM-користувача>
# і додатково S3_FORCE_PATH_STYLE=false (AWS працює з virtual-hosted адресами).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=product-images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Ліміт розміру зображення в байтах (2 МБ)
MAX_IMAGE_BYTES=2097152
# Скільки секунд діють presigned URL (PUT для завантаження і GET для показу)
S3_PRESIGN_EXPIRES_SEC=300

# Circuit breaker (модуль circuit-breaker): opossum або custom (src/common/circuit-breaker.ts)
BREAKER_IMPL=opossum
# custom: відкрити після N помилок за вікно. opossum: мінімум N викликів у вікні (volumeThreshold),
# і лише тоді breaker дивиться на відсоток помилок (50 %). Детально: docs/modules/circuit-breaker.md
BREAKER_FAILURE_THRESHOLD=5
BREAKER_WINDOW_MS=10000
# через скільки спробувати знову (half-open)
BREAKER_RESET_MS=30000
# виклик довший за це рахується як помилка
BREAKER_CALL_TIMEOUT_MS=2000

# Кеш прапорців у Redis, секунд
FLAGS_CACHE_TTL_SEC=10

# Листи: спроб до DLQ і базова затримка експоненційного backoff
EMAIL_ATTEMPTS=3
EMAIL_BACKOFF_MS=1000

# Relay outbox: період опитування і розмір пачки
OUTBOX_POLL_MS=1000
OUTBOX_BATCH_SIZE=50

# Трейсинг (OpenTelemetry -> Jaeger, docs/tracing.md). Порожньо = вимкнено. У docker compose підставляється http://jaeger:4318,
# локально з Jaeger у Docker: http://localhost:4318. OTEL_SERVICE_NAME: ім'я в Jaeger (api / worker), порожньо = patterns.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# Саґи: через скільки "зависла" саґа вважається покинутою і як часто worker це перевіряє.
# SAGA_RESUME_AFTER_MS має бути набагато більшим за найдовший крок (BREAKER_CALL_TIMEOUT_MS + запити в базу), див. docs/modules/saga.md
SAGA_RESUME_AFTER_MS=30000
SAGA_RESUME_POLL_MS=5000
