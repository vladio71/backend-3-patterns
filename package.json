{
  "name": "patterns",
  "version": "1.0.0",
  "private": true,
  "description": "Shop backend: 12 production patterns for a front-end developer who already knows backend basics",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "graph": "depcruise src --config .dependency-cruiser.cjs --output-type archi --include-only \"^src\" | dot -Tsvg -o docs/graphs/modules.svg",
    "graph:files": "depcruise src --config .dependency-cruiser.cjs --output-type dot --include-only \"^src\" | dot -Tsvg -o docs/graphs/files.svg",
    "docs:code": "compodoc -p tsconfig.build.json -d docs/compodoc -n \"patterns\" --disableCoverage --disableDomTree --disableTemplateTab --disableStyleTab",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "start:worker": "node --env-file-if-exists=.env dist/src/worker.js",
    "dev": "node --env-file-if-exists=.env -r ts-node/register/transpile-only src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env -r ts-node/register/transpile-only src/worker.ts",
    "migration:run": "node --env-file-if-exists=.env -r ts-node/register/transpile-only node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "node --env-file-if-exists=.env -r ts-node/register/transpile-only node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "seed": "node --env-file-if-exists=.env -r ts-node/register/transpile-only scripts/seed.ts",
    "test": "jest --config jest.unit.config.js",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "@bull-board/api": "9.10.5",
    "@bull-board/express": "9.10.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.3",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.81.2",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@scalar/nestjs-api-reference": "1.2.33",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "opossum": "10.0.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "11.2.8",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/opossum": "8.1.9",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
